#!/usr/bin/env bash
# gh, with a fresh claude[bot] token in GH_TOKEN. See scripts/claude_token.py.
# Inert unless CLAUDE_TOKEN_REFRESH=1 (the agent step only).
self_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
real=$(PATH=$(printf '%s' "$PATH" | tr ':' '\n' | grep -vxF "$self_dir" | paste -sd: -) command -v gh)
[ -n "$real" ] || { echo "gh wrapper: no real gh on PATH" >&2; exit 127; }
if [ "${CLAUDE_TOKEN_REFRESH:-}" = 1 ] && tok=$(python3 "$self_dir/claude_token.py"); then
  export GH_TOKEN="$tok" GITHUB_TOKEN="$tok"
fi
exec "$real" "$@"
