# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.python-version

# Env / secrets — covers .env, .env.local, .env.production, .env.staging etc.
.env
.env.*
!.env.example

# Google OAuth client secret — must never be committed.
client_secret_*.json

# prompteval artifacts
.prompteval/
report.html

# Bhagya runtime cache (LLM-response cache + usage log)
bhagya.db
bhagya.db-journal

# Editor / OS
.vscode/
.idea/
.DS_Store

# Firebase CLI local cache (auth, deploy artifacts)
.firebase/
firebase-debug.log

# Knowledge source PDFs — kept local only for copyright hygiene.
# Extractions live in src/astro_ai/knowledge/*.md and vedic_reference.md.
data/

# Agent heartbeat log — see CLAUDE.md "Report status while you run"
AGENT_STATUS.md

# Local agent/tooling state — never belongs in a deploy.
# These sat untracked-but-not-ignored for a long time, one `git add -A`
# away from shipping to production. See CLAUDE.md.
.local/
.serena/
QA_LOG.md

# Node is a build-only dependency (Tailwind CSS build). Never shipped.
node_modules/

# corpus_search.py extraction cache — derived from data/, which is itself
# ignored. Keyed on (path, size, mtime, pdftotext version, flags), so a
# changed or re-extracted book invalidates its own entry.
.corpus-cache/

# Scratch for the nightly rashifal job (#515). Lives in the workspace because
# Claude Code may only write inside it; never committed.
.rashifal-run/
