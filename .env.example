# Copy this file to `.env` and fill in your API key.
# `.env` is gitignored so your key never lands in version control.

# --------------------------------------------------------------------------
# LLM providers. Two ways to configure:
#
# RECOMMENDED — multi-provider chain (proactive load balancing + 429 fallback).
# Each request picks a random provider from the chain by default, falling
# through to the next on rate-limit / error. Effective free quota = sum of
# all provider quotas.
#
# ⚠ Model deprecation note (July 2026):
# Groq is decommissioning `llama-3.3-70b-versatile` on 2026-08-16. Our
# default Groq model has been updated to `openai/gpt-oss-120b`. Cerebras
# and Together still serve Llama 3.3 70B — no action needed there. If you
# had `GROQ_MODEL=llama-3.3-70b-versatile` set explicitly, remove that
# override before Aug 16 so the new default kicks in.
# --------------------------------------------------------------------------
# BHAGYA_LLM_PROVIDERS=groq,cerebras,together,openai
# BHAGYA_LLM_BALANCE=random      # 'random' (default) or 'order' for strict chain
# GROQ_API_KEY=gsk_...           # https://console.groq.com
# CEREBRAS_API_KEY=...           # https://cloud.cerebras.ai
# TOGETHER_API_KEY=...           # https://api.together.xyz
# MISTRAL_API_KEY=...            # https://console.mistral.ai
# OPENAI_API_KEY=sk-...          # paid-tier safety net at end
# Optional per-provider model overrides (defaults live in providers.py):
# GROQ_MODEL=openai/gpt-oss-120b     # current default; smaller alt: openai/gpt-oss-20b
# OPENAI_MODEL=gpt-4o-mini

# Editorial review log (off by default). When on, appends every LLM
# response — after reasoning-envelope stripping and quality-gate pass —
# to data/llm_review/YYYY-MM-DD.jsonl for eyeball review. Turn on
# locally after a prompt change / provider swap; turn off in prod.
# BHAGYA_LLM_REVIEW=1
# BHAGYA_LLM_REVIEW_DIR=data/llm_review
# BHAGYA_LLM_REVIEW_KEEP_DAYS=14

# --------------------------------------------------------------------------
# LEGACY single-provider mode (kept for back-compat). Use this if you just
# want one provider and don't need fallback. Three pre-configured examples:
# --------------------------------------------------------------------------

# === OpenAI ===
OPENAI_API_KEY=sk-...
# ASTRO_AI_MODEL=gpt-4o-mini      # optional; default is gpt-4o-mini

# === Groq (free tier, OpenAI-compatible) ===
# OPENAI_API_KEY=gsk_...
# ASTRO_AI_API_BASE=https://api.groq.com/openai/v1
# ASTRO_AI_MODEL=openai/gpt-oss-120b     # (was llama-3.3-70b-versatile — deprecated 2026-08-16)

# === Other OpenAI-compatible providers (vLLM, Ollama, ...) ===
# OPENAI_API_KEY=<your-key>
# ASTRO_AI_API_BASE=<https://provider/v1>
# ASTRO_AI_MODEL=<their-model-name>

# --------------------------------------------------------------------------
# Session cookie signing — change BEFORE deploying to production.
# Pick a long random string; old cookies become invalid when you change it.
# --------------------------------------------------------------------------
# ASTRO_AI_COOKIE_SECRET=replace-with-a-long-random-string-before-prod

# --------------------------------------------------------------------------
# Admin Basic-Auth password for /admin/usage (username is always 'admin').
# REQUIRED before deploying — falls back to a clearly-flagged dev string
# locally, but any deploy must set its own strong password here.
# --------------------------------------------------------------------------
# ADMIN_PASSWORD=pick-a-strong-password

# --------------------------------------------------------------------------
# GCS bucket for shared cache (currently used by /rashifal only).
# Optional locally; leave unset and the app falls back to SQLite-only caching.
# On Cloud Run, set it to make Rashifal a true 1-LLM-call-per-day-per-language
# system that survives container cold starts. Use a US multi-region bucket
# to stay inside the GCS Always-Free quota.
# --------------------------------------------------------------------------
# BHAGYA_STORAGE_BUCKET=bhagya-cache-us

# --------------------------------------------------------------------------
# Brevo for daily Rashifal email (optional locally; required to actually send).
# Free tier: 300 emails/day, unlimited contacts. Get the key at
# https://app.brevo.com/settings/keys/api after signing up + verifying sender.
# BHAGYA_EMAIL_FROM must be a sender you've verified inside Brevo.
# --------------------------------------------------------------------------
# BREVO_API_KEY=xkeysib-...
# BHAGYA_EMAIL_FROM=hello@bhagya.app

# --------------------------------------------------------------------------
# Absolute site URL for absolute links inside emails (back-to-site CTAs,
# unsubscribe links). Defaults to https://bhagya.app if unset.
# --------------------------------------------------------------------------
# BHAGYA_SITE_URL=https://bhagya.app

# --------------------------------------------------------------------------
# Google Sign-In (Google Identity Services). Client ID is a public OAuth 2.0
# identifier; safe to expose. Get it at:
# https://console.cloud.google.com/apis/credentials → Create OAuth Client ID
# → Web application → add https://your-domain + http://127.0.0.1:8000 to
# Authorized JavaScript Origins → copy the Client ID (ignore Client Secret;
# GIS browser flow doesn't use it).
# When unset, the Sign In button hides itself and /auth/google returns 503 —
# the app runs fine without auth, users just can't sign in.
# --------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com

# --------------------------------------------------------------------------
# Analytics (both optional; leave unset locally so dev events don't
# pollute prod data).
#
# GA4 — get measurement ID at https://analytics.google.com → Admin →
# Data Streams → your web stream. Format: G-XXXXXXXXXX.
# Clarity — get project ID at https://clarity.microsoft.com → New project
# → copy the alphanumeric ID from the tracking code snippet.
# --------------------------------------------------------------------------
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# CLARITY_PROJECT_ID=abc123def4

# --------------------------------------------------------------------------
# Telegram notifications for owner monitoring (both required to enable;
# silent no-op when either unset).
#
# Fires a private message to the owner's Telegram chat on Kundli generated,
# Matching done, Ask submitted, new sign-in, and newsletter subscribe.
# Setup:
#   1. Create a bot via @BotFather on Telegram → copy the bot token
#   2. Send the bot a message ("hi") so it can reply to you
#   3. Fetch your chat_id:
#        curl "https://api.telegram.org/bot<TOKEN>/getUpdates"
#      Find "chat":{"id":123456789} in the response
#   4. Set both vars below
# --------------------------------------------------------------------------
# BHAGYA_TELEGRAM_BOT_TOKEN=1234567890:AABBccDDeeFFggHHiiJJkkLLmmNNooPPqq
# BHAGYA_TELEGRAM_OWNER_CHAT_ID=123456789
