# Copy this file to `.env` and fill in your API key.
# `.env` is gitignored so your key never lands in version control.

# --------------------------------------------------------------------------
# Provider — pick ONE of the blocks below.
# --------------------------------------------------------------------------

# === OpenAI (default) ===
OPENAI_API_KEY=sk-...
# ASTRO_AI_MODEL=gpt-4o-mini      # optional; default is gpt-4o-mini

# === Groq (free tier, OpenAI-compatible) ===
# Sign up at https://console.groq.com — paste your Groq key as OPENAI_API_KEY.
# OPENAI_API_KEY=gsk_...
# ASTRO_AI_API_BASE=https://api.groq.com/openai/v1
# ASTRO_AI_MODEL=llama-3.3-70b-versatile

# === Other OpenAI-compatible providers (Together, Mistral, vLLM, Ollama, ...) ===
# OPENAI_API_KEY=<your-key>
# ASTRO_AI_API_BASE=<https://provider/v1>
# ASTRO_AI_MODEL=<their-model-name>

# --------------------------------------------------------------------------
# Session cookie signing — change BEFORE deploying to production.
# Pick a long random string; old cookies become invalid when you change it.
# --------------------------------------------------------------------------
# ASTRO_AI_COOKIE_SECRET=replace-with-a-long-random-string-before-prod
